{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "/home/esra/.config/fastfetch/logo/yeezus.txt",
        "color": {
            "1": "38;2;242;242;242",
            "2": "38;2;255;69;58"
        },
        "padding": { "top": 2, "left": 2, "right": 4 }
    },

    "display": {
        "brightColor": false,
        "separator": "  ",
        "key": { "width": 14, "type": "both-1" },
        "color": {
            "keys": "38;2;153;153;153",
            "title": "1;38;2;255;255;255",
            "output": "38;2;242;242;242",
            "separator": "38;2;82;82;82"
        },
        "bar": {
            "width": 8,
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": {
                "left": "",
                "right": ""
            },
            "color": {
                "elapsed": "38;2;255;69;58",
                "total": "38;2;64;64;64",
                "border": "38;2;82;82;82"
            }
        },
        "percent": {
            "type": ["num", "bar"],
            "color": {
                "green": "38;2;190;190;190",
                "yellow": "38;2;255;69;58",
                "red": "38;2;255;69;58"
            }
        }
    },

    "modules": [
        "break",
        {
            "type": "title",
            "key": " ",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
            "color": {
                "user": "38;2;255;69;58",
                "at": "38;2;102;102;102",
                "host": "38;2;242;242;242"
            }
        },
        "break",
        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[38;2;82;82;82m╭── \u001b[38;2;255;69;58mSYSTEM  \u001b[38;2;82;82;82m─────────────────────────────╮\u001b[0m"
        },
        { "type": "os",       "key": "OS",       "keyIcon": "", "format": "{name}" },
        { "type": "kernel",   "key": "KERNEL",   "keyIcon": "", "format": "{release}" },
        { "type": "wm",       "key": "WINDOW",   "keyIcon": "", "format": "{pretty-name} {version}" },
        { "type": "shell",    "key": "SHELL",    "keyIcon": "" },
        { "type": "terminal", "key": "TERMINAL", "keyIcon": "" },
        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[38;2;82;82;82m╰────────────────────────────────────────╯\u001b[0m"
        },
        "break",

        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[38;2;82;82;82m╭── \u001b[38;2;255;69;58mHARDWARE\u001b[38;2;82;82;82m─────────────────────────────╮\u001b[0m"
        },
        { "type": "cpu",    "key": "CPU",  "keyIcon": "", "format": "{name}" },
        {
            "type": "memory",
            "key": "RAM",
            "keyIcon": "󰍛",
            "percent": { "type": ["num", "bar"] },
            "format": "{percentage-bar}  {used}"
        },
        {
            "type": "disk",
            "key": "DISK /",
            "keyIcon": "",
            "folders": "/",
            "percent": { "type": ["num", "bar"] },
            "format": "{size-percentage-bar}  {size-used}"
        },
        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[38;2;82;82;82m╰────────────────────────────────────────╯\u001b[0m"
        },
        "break",

        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[38;2;82;82;82m╭── \u001b[38;2;255;69;58mSESSION \u001b[38;2;82;82;82m─────────────────────────────╮\u001b[0m"
        },
        { "type": "uptime", "key": "UPTIME", "keyIcon": "󰅐" },
        {
            "type": "battery",
            "key": "BATTERY",
            "keyIcon": "󰁹",
            "percent": { "type": ["num", "bar"] },
            "format": "{capacity-bar}  {capacity}"
        },
        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[38;2;82;82;82m╰────────────────────────────────────────╯\u001b[0m"
        },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
    ]
}
